# Copy to server/.env and fill in. .env is git-ignored.

# Server (binds to localhost only; it can run diagnostics on this machine)
PORT=3001
HOST=127.0.0.1
CLIENT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Logging: trace | debug | info | warn | error
LOG_LEVEL=info

# OpenAI (Agents SDK)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
