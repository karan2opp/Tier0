# Copy to server/.env and fill in. .env is git-ignored.

# Server (binds to localhost only; it can run diagnostics on this machine)
PORT=3001
HOST=127.0.0.1
CLIENT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Chat messages allowed per IP per minute (all chat endpoints together)
CHAT_RATE_LIMIT_PER_MINUTE=20
# Voice requests (agent speech + transcription) allowed per IP per minute
VOICE_RATE_LIMIT_PER_MINUTE=40

# Logging: trace | debug | info | warn | error
LOG_LEVEL=info

# Postgres (docker compose up -d). Optional locally: this is also the built-in dev default.
DATABASE_URL=postgres://tier0:tier0_local_dev@127.0.0.1:5434/tier0

# OpenAI (Agents SDK)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional OpenAI voice (the browser voice is used otherwise)
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
